<UserControl x:Class="ModernUninstaller.Pages.ToolboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Toolbox" FontSize="24" FontWeight="SemiBold" Margin="4,6,0,0"/>
        <Border Grid.Row="1" Margin="0,16,0,0" Background="{DynamicResource Surface}" CornerRadius="22" Padding="22,22,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="Tiles"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
