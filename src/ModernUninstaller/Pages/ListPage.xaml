<UserControl x:Class="ModernUninstaller.Pages.ListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="4,6,0,0">
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
            <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Background="{DynamicResource Surface}" CornerRadius="22" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- List side -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button x:Name="FilterBtn" Style="{StaticResource PillButton}" Click="Filter_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                                <TextBlock Text="Filtern nach: " Foreground="{DynamicResource TextDim}"/>
                                <TextBlock x:Name="FilterLabel" FontWeight="SemiBold" Text="Alle Laufwerke"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SortBtn" Style="{StaticResource PillButton}" Click="Sort_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                                <TextBlock Text="Sortieren nach: " Foreground="{DynamicResource TextDim}"/>
                                <TextBlock x:Name="SortLabel" FontWeight="SemiBold" Text="Bezeichnung"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListBox x:Name="List" Grid.Row="1" Foreground="{DynamicResource Text}" FocusVisualStyle="{x:Null}" Background="Transparent" BorderThickness="0" SelectionMode="Single"
                             ItemContainerStyle="{StaticResource CardListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" SelectionChanged="List_SelectionChanged" Padding="0,0,8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Left">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextDim}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding DateText}" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                                    <Button Grid.Column="5" Style="{StaticResource DangerIconButton}" Content="&#xE74D;" Tag="{Binding}" Click="RowAction_Click" ToolTip="Entfernen"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="420">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="52" HorizontalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource Dim}" TextAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="LoadingText" Grid.Row="1" Text="Lade …" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Right panel -->
                <Grid Grid.Column="1" Margin="28,0,0,0">
                    <Grid x:Name="SummaryPanel">
                        <StackPanel VerticalAlignment="Top" Margin="0,40,0,0">
                            <Border Width="104" Height="104" CornerRadius="52" BorderThickness="2" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}">
                                <TextBlock x:Name="SummaryGlyph" Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                <TextBlock x:Name="CountText" FontSize="19" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <TextBlock x:Name="CountLabel" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                            </StackPanel>
                            <Border Background="{DynamicResource Card}" CornerRadius="14" Padding="16" Margin="0,26,0,0">
                                <StackPanel>
                                    <TextBlock Text="Kürzlich installiert" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="RecentList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DateText}" Foreground="{DynamicResource TextDim}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,24,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="DetailIcon" Width="52" Height="52" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DetailName" TextWrapping="Wrap" MaxWidth="200" Foreground="{DynamicResource TextDim}"/>
                                <TextBlock x:Name="DetailSize" FontSize="22" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Version:" Style="{StaticResource Dim}" Margin="0,22,0,2" FontSize="12"/>
                        <TextBlock x:Name="DetailVersion" TextWrapping="Wrap"/>
                        <TextBlock Text="Herausgeber:" Style="{StaticResource Dim}" Margin="0,14,0,2" FontSize="12"/>
                        <TextBlock x:Name="DetailPublisher" TextWrapping="Wrap"/>
                        <TextBlock Text="Installationspfad:" Style="{StaticResource Dim}" Margin="0,14,0,2" FontSize="12"/>
                        <TextBlock x:Name="DetailPath" TextWrapping="Wrap"/>
                        <TextBlock Text="Installationsdatum:" Style="{StaticResource Dim}" Margin="0,14,0,2" FontSize="12"/>
                        <TextBlock x:Name="DetailDate" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailLogLabel" Text="Installations-Protokoll:" Style="{StaticResource Dim}" Margin="0,14,0,2" FontSize="12" Visibility="Collapsed"/>
                        <TextBlock x:Name="DetailLog" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource Accent}"/>
                    </StackPanel>

                    <Button x:Name="ActionBtn" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="12,0,0,0"
                            FontSize="15" Padding="28,14" Click="Action_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>


