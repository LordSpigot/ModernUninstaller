<local:DialogWindow x:Class="ModernUninstaller.Dialogs.ListToolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModernUninstaller"
        Title="Tool" Width="820" Height="620">
    <Grid Margin="28,0,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="Intro" Style="{StaticResource Dim}" Margin="0,6,0,14"/>
        </StackPanel>

        <ListBox x:Name="Rows" Grid.Row="1" Foreground="{DynamicResource Text}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bd" Background="{DynamicResource Card}" CornerRadius="10" Margin="0,0,0,6" Padding="14,10">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="{Binding CheckVisibility}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Placeholder" Grid.Row="1" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Lade …" TextAlignment="Center"/>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="Status" Style="{StaticResource Dim}" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="420"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Schließen" Width="140" Margin="0,0,12,0" Click="Close_Click"/>
                <Button x:Name="ActionBtn" Style="{StaticResource PrimaryButton}" Width="190" Click="Action_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:DialogWindow>

