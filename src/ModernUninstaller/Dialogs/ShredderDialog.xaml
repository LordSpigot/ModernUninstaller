<local:DialogWindow x:Class="ModernUninstaller.Dialogs.ShredderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModernUninstaller"
        Title="Datei-Shredder" Width="760" Height="600" AllowDrop="True" Drop="Window_Drop">
    <Grid Margin="28,0,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Datei-Shredder" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,14"
                       Text="Dateien oder Ordner hierher ziehen oder hinzufügen. Der Inhalt wird überschrieben und die Datei gelöscht. Auf SSDs ist das kein Garant für endgültiges Löschen."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Style="{StaticResource SecondaryButton}" Content="Dateien …" Padding="20,9" Margin="0,0,10,0" Click="AddFiles_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Ordner …" Padding="20,9" Margin="0,0,10,0" Click="AddFolder_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Liste leeren" Padding="20,9" Click="Clear_Click"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Border}" Padding="8">
            <Grid>
                <ListBox x:Name="PathList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"/>
                <TextBlock x:Name="DropHint" Text="Hier ablegen" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="Modus:" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="ModeBox" Width="320" SelectedIndex="1">
                <ComboBoxItem Content="Schnell (1 Durchgang)"/>
                <ComboBoxItem Content="Erweitert (3 Durchgänge)"/>
                <ComboBoxItem Content="Fachgerecht (7 Durchgänge)"/>
            </ComboBox>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="Status" Style="{StaticResource Dim}" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Schließen" Width="140" Margin="0,0,12,0" Click="Close_Click"/>
                <Button x:Name="ShredBtn" Style="{StaticResource PrimaryButton}" Content="Vernichten" Width="170" Click="Shred_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:DialogWindow>
