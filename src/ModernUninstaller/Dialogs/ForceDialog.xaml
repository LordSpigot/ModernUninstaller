<local:DialogWindow x:Class="ModernUninstaller.Dialogs.ForceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModernUninstaller"
        Title="Erzwungene Deinstallation" Width="760" Height="520" AllowDrop="True" Drop="Window_Drop">
    <Grid Margin="28,0,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Erzwungene Deinstallation" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,16"
                       Text="Ziehen Sie den Ordner oder die EXE-/Verknüpfungsdatei eines Programms hierher. Gibt es einen passenden Eintrag, können Sie normal deinstallieren. Sonst werden nur Reste gesucht und entfernt."/>
            <TextBlock Text="Ordner oder Datei" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Style="{StaticResource FieldTextBox}" TextChanged="PathBox_TextChanged"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Ordner …" Padding="18,9" Margin="10,0,0,0" Click="Folder_Click"/>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Datei …" Padding="18,9" Margin="10,0,0,0" Click="File_Click"/>
            </Grid>
            <TextBlock Text="Programmname (für die Suche nach Resten)" Margin="0,16,0,6"/>
            <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}"/>
        </StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource Card}" CornerRadius="14" Padding="18,14" Margin="0,18,0,0" VerticalAlignment="Top">
            <TextBlock x:Name="MatchText" TextWrapping="Wrap" Text="Noch nichts ausgewählt."/>
        </Border>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Schließen" Width="130" Margin="0,0,12,0" Click="Close_Click"/>
                <Button x:Name="NormalBtn" Style="{StaticResource SecondaryButton}" Content="Deinstallieren" Width="160" Margin="0,0,12,0" Click="Normal_Click" IsEnabled="False"/>
                <Button x:Name="ForceBtn" Style="{StaticResource PrimaryButton}" Content="Reste erzwungen entfernen" Width="240" Click="Force_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:DialogWindow>
