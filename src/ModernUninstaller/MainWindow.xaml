<Window x:Class="ModernUninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modern Uninstaller" Icon="Assets/ModernUninstaller.ico" Width="1200" Height="780" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Width="32" Height="32" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Center">
                <Image Source="/Assets/ModernUninstaller.png" Width="27" Height="27" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,12,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <RadioButton x:Name="NavPrograms" Style="{StaticResource NavItem}" Tag="&#xE71D;" ToolTip="Programme" GroupName="nav" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavHealth" Style="{StaticResource NavItem}" Tag="&#xE9D9;" ToolTip="Software Health" GroupName="nav" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavExtensions" Style="{StaticResource NavItem}" Tag="&#xEA86;" ToolTip="Browser-Erweiterungen" GroupName="nav" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Tag="&#xE7B8;" ToolTip="Windows Apps" GroupName="nav" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavToolbox" Style="{StaticResource NavItem}" Tag="&#xE90F;" ToolTip="Toolbox" GroupName="nav" Checked="Nav_Checked"/>
            </StackPanel>
        </Grid>

        <!-- Main column -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBox x:Name="SearchBox" Style="{StaticResource PillTextBox}" Width="440" Height="36" VerticalContentAlignment="Center"
                         HorizontalAlignment="Center" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                         TextChanged="Search_TextChanged"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="AdminBadge" Style="{StaticResource PillButton}" Padding="12,5" Margin="0,0,10,0" Click="Elevate_Click" Visibility="Collapsed"
                            ToolTip="Ohne Administratorrechte können Systemprogramme nicht deinstalliert werden. Klicken zum Neustart als Administrator.">
                        <TextBlock Text="Eingeschränkt – als Administrator starten" Foreground="{DynamicResource Warn}" FontSize="12"/>
                    </Button>
                    <Button x:Name="ThemeBtn" Style="{StaticResource IconButton}" Content="&#xE706;" Click="Theme_Click" ToolTip="Hell/Dunkel umschalten"/>
                    <Button x:Name="MenuBtn" Style="{StaticResource IconButton}" Content="&#xE700;" Click="Menu_Click" ToolTip="Menü"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="Minimize_Click" Margin="8,0,0,0"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource IconButton}" Content="&#xE922;" Click="Maximize_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,0,14,14"/>
        </Grid>
    </Grid>
</Window>
